# Copy to /path/to/cashflow/backup.env and fill in. Never commit the real file.

# The live database, the same path the app unit passes to -db.
DB_PATH=/path/to/cashflow/finances.db
# Folder for the dated copies, created if missing; all copies are kept here.
BACKUP_DIR=/path/to/cashflow/backups

# Healthchecks ping URL, pinged after every fully successful run. Required.
# Keep the real URL only here: whoever has it can send fake "all good" pings.
PING_URL=https://hc-ping.com/your-check-uuid

# Optional: rclone destination (remote:path) the backup folder is copied to.
# Nothing is ever deleted there. Leave unset to keep backups local only.
#RCLONE_DEST=myremote:cashflow
