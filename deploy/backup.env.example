# Copy to /etc/moneymanager/backup.env on the host and fill in. Never commit the real file.

# The live database, the same path the app service passes to -db.
DB_PATH=/var/lib/moneymanager/money_manager.db
# Local folder for the dated copies; all copies are kept here.
BACKUP_DIR=/var/backups/moneymanager

# The dedicated TrueNAS user and its dataset.
NAS_HOST=truenas.local
NAS_USER=cashflow-backup
# Target path on the NAS. With the key restricted by rrsync this is relative
# to the dataset, so "." means the dataset itself.
NAS_PATH=.
# Private key of the dedicated backup key pair, readable only by the service user.
SSH_KEY=/etc/moneymanager/backup_ed25519

# Healthchecks ping URL, pinged after every fully successful run. Required.
# Keep the real URL only here: whoever has it can send fake "all good" pings.
PING_URL=https://hc-ping.com/your-check-uuid

# Seconds before an unreachable NAS fails the run (default 10).
#SSH_CONNECT_TIMEOUT=10
