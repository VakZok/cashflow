# systemd user timer for the Cashflow backup. Install (untested): see
# deploy/BACKUP.md.

[Unit]
Description=Run the Cashflow database backup nightly at 03:00

[Timer]
OnCalendar=*-*-* 03:00:00
# A run missed while the machine was off happens at the next boot.
Persistent=true

[Install]
WantedBy=timers.target
